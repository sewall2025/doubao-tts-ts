# 豆包 TTS TypeScript 版配置示例
#   cp .env.example .env  然后按需修改

# ---------- 鉴权（重要）----------
# 服务持有你的豆包登录态，任何能访问端口的人都能用你的账号。
# 生成: node -e "console.log('sk-'+require('crypto').randomBytes(24).toString('base64url'))"
# 留空 = 不鉴权，此时只绑 127.0.0.1；留空又监听非回环会拒绝启动。
DOUBAO_TTS_API_KEY=sk-change-me

# ---------- Cookie ----------
# 从浏览器 DevTools 复制的完整 Cookie 头。首次启动会播种进存储。
DOUBAO_TTS_COOKIE=

# ---------- 存储后端 ----------
# file  = Docker/VPS 单机（cookie 落盘 + 内存限流）
# redis = Vercel/多实例（cookie 存 Redis + 分布式限流）
STORAGE_BACKEND=file
# file 后端的 cookie 目录
DOUBAO_TTS_DATA_DIR=/data
# redis 后端（Vercel KV 或 Upstash）
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------- 监听 ----------
DOUBAO_TTS_HOST=0.0.0.0
DOUBAO_TTS_PORT=8000

# ---------- 限流 ----------
DOUBAO_TTS_RATE_MAX=8
DOUBAO_TTS_RATE_WINDOW=1

# ---------- 其他 ----------
DOUBAO_TTS_MAX_INPUT=4096
DOUBAO_TTS_KEEPALIVE=1
DOUBAO_TTS_KEEPALIVE_INTERVAL_H=12
DOUBAO_TTS_KEEPALIVE_THRESHOLD_D=25
# Vercel Cron 保护（可选）
# CRON_SECRET=
