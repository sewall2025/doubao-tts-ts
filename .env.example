# 豆包 TTS · Vercel 部署配置示例
# Docker/VPS 部署请用 .env.docker.example
#
# Vercel 导入项目时会把本文件里「未注释」的变量列成输入字段。
# 这里只留一个必填项，其余都注释掉（有默认值 / 由 KV 集成自动注入）。

# ---------- 鉴权（必填）----------
# 客户端用它做 Bearer 鉴权。自定义一串，如 sk-xxxx。
# 生成: node -e "console.log('sk-'+require('crypto').randomBytes(24).toString('base64url'))"
DOUBAO_TTS_API_KEY=sk-change-me

# ---------- 存储后端（KV / 自动）----------
# 连上 Upstash for Redis 集成后，Vercel 自动注入下面两个变量，无需手填。
# 代码检测到它们就自动用 redis，STORAGE_BACKEND 不用设。
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------- Cookie ----------
# cookie 不走环境变量。部署后往 KV 写 cookie 键：
#   Upstash 控制台 Data Browser 或 CLI: SET cookie "浏览器复制的完整Cookie头"

# ---------- 可选项（都有默认值，一般不用设）----------
# CRON_SECRET=            # 保护定时续期端点 /api/cron/renew
# DOUBAO_TTS_MAX_INPUT=4096          # 单次文本长度上限
# DOUBAO_TTS_RATE_MAX=8              # 限流窗口内最大请求数
# DOUBAO_TTS_RATE_WINDOW=1           # 限流窗口秒数
# DOUBAO_TTS_KEEPALIVE_THRESHOLD_D=25  # cookie 剩余天数低于此值才续期
