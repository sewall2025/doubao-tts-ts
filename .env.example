# 豆包 TTS TypeScript 版配置示例
#   cp .env.example .env  然后按需修改

# ---------- 鉴权（重要）----------
# 服务持有你的豆包登录态，任何能访问端口的人都能用你的账号。
# 生成: node -e "console.log('sk-'+require('crypto').randomBytes(24).toString('base64url'))"
# 留空 = 不鉴权，此时只绑 127.0.0.1；留空又监听非回环会拒绝启动。
DOUBAO_TTS_API_KEY=sk-change-me

# ---------- Cookie ----------
# cookie 不走环境变量，直接写进存储：
#   Docker/file: 把浏览器复制的 Cookie 头写进  <DATA_DIR>/.store_cookie
#                例: echo "完整Cookie头" > ./data/.store_cookie
#   Vercel/redis: 往 KV 写 cookie 键（Upstash 控制台或 CLI: redis-cli SET cookie "...")

# ---------- 存储后端 ----------
# file  = Docker/VPS 单机（cookie 存单个文件 .store_cookie + 内存限流）
# redis = Vercel/多实例（cookie 存 Redis + 分布式限流）
STORAGE_BACKEND=file
# file 后端的 cookie 目录：.store_cookie 就存在这里。
# 本地开发用项目相对目录 ./data；Docker 里由 Dockerfile 覆盖为 /data（挂卷）。
DOUBAO_TTS_DATA_DIR=./data
# redis 后端（Vercel KV 或 Upstash）
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------- 监听 ----------
DOUBAO_TTS_HOST=0.0.0.0
DOUBAO_TTS_PORT=8000

# ---------- 限流 / 并发 ----------
# 限流窗口：每 RATE_WINDOW 秒内最多 RATE_MAX 个请求
DOUBAO_TTS_RATE_MAX=8
DOUBAO_TTS_RATE_WINDOW=1
# 同时连豆包的最大并发数（信号量，防连接风暴触发 ETIMEDOUT）
DOUBAO_TTS_CONCURRENCY=8

# ---------- 其他 ----------
# 单次文本长度上限
DOUBAO_TTS_MAX_INPUT=4096
# cookie 保温：心跳端点滚动续期登录态。0/false/off 关闭
DOUBAO_TTS_KEEPALIVE=1
# 保温检查间隔（小时，仅 Docker 定时器；Vercel 用 Cron）
DOUBAO_TTS_KEEPALIVE_INTERVAL_H=12
# 剩余天数低于此值才触发续期
DOUBAO_TTS_KEEPALIVE_THRESHOLD_D=25
# Vercel Cron 保护（可选）
# CRON_SECRET=
